{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler", //ts 5.9以前のデフォルト値(classic)だとVue等がimportできない
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noFallthroughCasesInSwitch": true,

    // 型定義ファイル出力用 (拡張機能制作者向け)
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "output",
  },
  "include": [
    "*",
    "game/*",
  ]
}